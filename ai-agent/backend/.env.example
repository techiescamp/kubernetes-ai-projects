# AWS region for Bedrock
AWS_REGION=us-east-1

# Bedrock model IDs
DIAGNOSTICS_MODEL_ID=us.amazon.nova-pro-v1:0
REMEDIATION_MODEL_ID=us.meta.llama4-maverick-17b-instruct-v1:0

# Optional: $ per 1K tokens for each model, used only to print an estimated session cost
# alongside token counts. Leave unset (or blank) to see token counts only, with no cost
# estimate. Values below are on-demand us-east-1 pricing as of Jul 2026 - re-check the
# AWS Bedrock pricing page for your region before relying on these for real budgeting.
DIAGNOSTICS_MODEL_PRICE_INPUT_PER_1K=0.0008
DIAGNOSTICS_MODEL_PRICE_OUTPUT_PER_1K=0.0032
REMEDIATION_MODEL_PRICE_INPUT_PER_1K=0.00024
REMEDIATION_MODEL_PRICE_OUTPUT_PER_1K=0.00097

# Optional: Postgres connection string for durable LangGraph checkpoint storage (paused
# approval sessions survive restarts and are shared across replicas). Leave unset to use the
# in-process MemorySaver for local dev (state lost on restart, single-process only).
# DATABASE_URL=postgresql://ai_agent:password@localhost:5432/ai_agent

# Optional: log level for the logging module (DEBUG/INFO/WARNING/ERROR). Defaults to INFO.
# LOG_LEVEL=INFO

# Optional: comma/regex origin pattern the FastAPI backend accepts CORS requests from. Defaults
# to the local Next.js dev server (localhost/127.0.0.1, any port).
# ALLOWED_ORIGINS=http://(localhost|127\.0\.0\.1):\d+

# Optional: caps how many times the remediation loop retries after a failed verification.
# MAX_REMEDIATION_ATTEMPTS=3

# Optional: set to "development" to enable uvicorn's auto-reload when running `python main.py`
# locally. Never set this in a deployed environment.
# ENVIRONMENT=development
